                                      <Value>LOAN TYPE APPLIED FOR (tick one)</Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
